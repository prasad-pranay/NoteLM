
# ==========================================
# Server Configuration
# ==========================================

# Backend server port (Default: 5000).
# Change only if port 5000 is already in use.
PORT=5000


# ==========================================
# Database Configuration
# ==========================================

# [REQUIRED] MongoDB connection URI.
# Keep the default for local MongoDB.
# For MongoDB Atlas, replace with your connection string:
# https://www.mongodb.com/products/platform/atlas-database
MONGO_URI=mongodb://localhost:27017/notelm


# ==========================================
# Authentication & JWT Configuration
# ==========================================

# [REQUIRED] Secret key used to sign access tokens.
# Replace the development value with a strong random secret in production.
JWT_SECRET=dev_secret_key_change_in_production

# [REQUIRED] Secret key used to sign refresh tokens.
# Must be different from JWT_SECRET.
# Replace the development value before production deployment.
JWT_REFRESH_SECRET=dev_refresh_secret_key_change_in_production

# Access token expiration duration (Default: 15 minutes).
# Examples: 15m, 30m, 1h.
JWT_EXPIRE=15m

# Refresh token expiration duration (Default: 7 days).
# Examples: 7d, 14d, 30d.
JWT_REFRESH_EXPIRE=7d


# ==========================================
# AI Model Configuration
# ==========================================

# [OPTIONAL] Google Gemini API key.
# Required only if you want to use Gemini-based AI generation.
# Get your API key from:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=GET_YOUR_GEMINNI_API_KEY

# [REQUIRED FOR OLLAMA] Ollama server URL.
# Keep the default if Ollama is running on the same machine.
# https://ollama.com/
OLLAMA_BASE_URL=http://localhost:11434

# Chat model used for AI response generation (Default: phi3).
# Download using: ollama pull phi3
# https://ollama.com/library
OLLAMA_CHAT_MODEL=phi3

# Embedding model used for document vectorization (Default: nomic-embed-text).
# Download using: ollama pull nomic-embed-text
# https://ollama.com/library/nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text


# ==========================================
# File Upload & Storage Configuration
# ==========================================

# Directory for storing uploaded files (Default: ./uploads).
UPLOAD_DIR=./uploads

# Directory for storing local vector embeddings (Default: ./vector-store).
VECTOR_STORE_DIR=./vector-store

# Maximum allowed file upload size in MB (Default: 50).
MAX_FILE_SIZE_MB=50


# ==========================================
# RAG Configuration
# ==========================================

# Number of characters per document chunk (Default: 512).
CHUNK_SIZE=512

# Overlapping characters between consecutive chunks (Default: 64).
CHUNK_OVERLAP=64

# Number of relevant chunks retrieved for each query (Default: 5).
TOP_K_RESULTS=5


# ==========================================
# Rate Limiting Configuration
# ==========================================

# Rate limit time window in milliseconds (Default: 15 minutes).
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests allowed per IP within the time window (Default: 100).
RATE_LIMIT_MAX=100

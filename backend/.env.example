# Backend .env Configuration
PORT=5000
MONGO_URI=mongodb://localhost:27017/notelm
JWT_SECRET=change_this_to_a_very_long_random_secret_key_64chars
JWT_REFRESH_SECRET=change_this_to_another_very_long_random_secret_key
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=phi3
OLLAMA_EMBED_MODEL=nomic-embed-text

# File Upload
UPLOAD_DIR=./uploads
VECTOR_STORE_DIR=./vector-store
MAX_FILE_SIZE_MB=50

# RAG Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RESULTS=5

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
